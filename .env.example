# =================================================================
# AI SQL Query Generator — variables de entorno (plantilla)
# =================================================================
# Copia este archivo a .env y rellena los valores reales:
#   cp .env.example .env       (macOS / Linux)
#   copy .env.example .env     (Windows)
#
# IMPORTANTE: .env está en .gitignore. Nunca lo commitees.
# =================================================================

# --- MiniMax (proveedor de IA) ---
# Tu API key de MiniMax. Obtenerla en https://api.MiniMax.com
MINIMAX_API_KEY=your_api_key_here

# Endpoint de la API de MiniMax (compatible con OpenAI)
MINIMAX_BASE_URL=https://api.MiniMax.com/v1

# Modelo a usar. Por defecto el mismo que me hace funcionar a mi.
MINIMAX_MODEL=opencode-go/MiniMax-M3

# --- Base de datos (PostgreSQL vía Docker Compose) ---
# Apunta al contenedor de docker-compose.yml que levantamos en Task 1.
# Las credenciales deben coincidir con las del compose.
DATABASE_URL=postgresql://sqlgen:sqlgen_dev_password@localhost:5432/sqlgen

# --- UI ---
# Idioma por defecto: "es" (español) o "en" (inglés).
# El usuario puede cambiarlo desde la sidebar de Streamlit.
APP_LANGUAGE=es
